<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><IsPackable>false</IsPackable><IsTestProject>true</IsTestProject></PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1"><PrivateAssets>all</PrivateAssets><IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets></PackageReference>
    <ProjectReference Include="../../src/Agent/BuildSystem.Agent/BuildSystem.Agent.csproj" />
  </ItemGroup>
  <Target Name="CopyAgentFixture" AfterTargets="Build">
    <MSBuild Projects="../../src/Agent/BuildSystem.Agent/BuildSystem.Agent.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_AgentFixtureTarget" />
    </MSBuild>
    <ItemGroup>
      <_AgentFixtureOutput Include="%(_AgentFixtureTarget.RootDir)%(_AgentFixtureTarget.Directory)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AgentFixtureOutput)" DestinationFiles="@(_AgentFixtureOutput->'$(OutDir)AgentFixture/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
