<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="../../src/Agent/BuildSystem.Agent.Tools/BuildSystem.Agent.Tools.csproj" />
    <ProjectReference Include="../BuildSystem.ProcessFixture/BuildSystem.ProcessFixture.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyProcessFixture" AfterTargets="Build">
    <MSBuild Projects="../BuildSystem.ProcessFixture/BuildSystem.ProcessFixture.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_FixtureTarget" />
    </MSBuild>
    <ItemGroup>
      <_FixtureOutput Include="%(_FixtureTarget.RootDir)%(_FixtureTarget.Directory)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_FixtureOutput)" DestinationFiles="@(_FixtureOutput->'$(OutDir)ProcessFixture/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
